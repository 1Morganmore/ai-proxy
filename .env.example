# 国家反诈 AI 访问令牌 (Access Token)
FANZHA_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# 国家反诈 AI 刷新令牌 (Refresh Token, 用于 90 天自动长效续期，可选)
FANZHA_REFRESH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# 服务配置
HOST=127.0.0.1
PORT=8088
DEFAULT_MODEL=国家反诈AI
# 是否把客户端 role=system 转写进上游（默认 false；开启容易触发反诈护栏）
FORWARD_SYSTEM_PROMPT=false
# 反诈护栏拒答（固定 40 字拒绝语 / 与反诈无关 路由标记）是否映射为错误：
# true = 非流式 503 (detail: fanzha_out_of_domain)，流式 SSE error 终止；false = 原样返回拒答文本
FANZHA_REFUSAL_AS_ERROR=true
# 回答样板文字清理：off | intent-only | full（默认 intent-only）
# intent-only = 去掉内嵌的 current_intent 块；full = 另外去掉结尾的“防范建议”段
STRIP_BOILERPLATE=intent-only

